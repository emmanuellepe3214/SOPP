            document.getElementById("qrcodeBig").innerHTML = ""; // Limpiar previo
            new QRCode(document.getElementById("qrcodeBig"), {
                text: window.location.href,
                width: 250,
                height: 250,
                colorDark : "#4a148c",
                colorLight : "#ffffff",
