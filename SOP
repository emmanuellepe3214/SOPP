<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP Risk Analytics | Demo Day</title>
    <!-- Fuente profesional -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- Librería para generar QR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <style>
        /* --- VARS & RESET --- */
        :root {
            --primary: #6a1b9a;
            --primary-light: #9c4dcc;
            --accent: #00bfa5;
            --bg: #f8f9fa;
            --surface: #ffffff;
            --text-main: #2c3e50;
            --text-sec: #636e72;
            --danger: #e17055;
            --warning: #fdcb6e;
            --success: #00b894;
            --sidebar-width: 280px;
            --ai-gradient: linear-gradient(135deg, #6a1b9a 0%, #ff4081 100%);
        }

        * { box-sizing: border-box; }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            display: flex;
        }

        /* --- PANTALLA DE PRESENTACIÓN (NUEVO) --- */
        #presentationOverlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #4a148c, #7b1fa2);
            z-index: 3000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
            transition: transform 0.6s cubic-bezier(0.86, 0, 0.07, 1);
        }

        #presentationOverlay.hidden {
            transform: translateY(-100%);
        }

        .pres-content {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            padding: 50px;
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.2);
            max-width: 600px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .pres-title { font-size: 3rem; font-weight: 800; margin: 0 0 10px 0; letter-spacing: -1px; }
        .pres-subtitle { font-size: 1.2rem; opacity: 0.9; margin-bottom: 30px; font-weight: 300; }
        
        #qrBigContainer {
            background: white;
            padding: 20px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .btn-start-demo {
            background: white;
            color: var(--primary);
            border: none;
            padding: 15px 40px;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        .btn-start-demo:hover { transform: scale(1.05); box-shadow: 0 8px 25px rgba(0,0,0,0.3); }

        /* --- LAYOUT APP --- */
        .app-container {
            display: flex;
            width: 100%;
            height: 100vh;
            background: var(--surface);
            overflow: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(160deg, var(--primary), #4a148c);
            color: white;
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-shrink: 0;
            height: 100%;
            overflow-y: auto;
        }

        .brand h2 { margin: 0; font-weight: 700; letter-spacing: -1px; }
        .brand span { font-weight: 300; font-size: 0.9rem; opacity: 0.8; }

        .steps-nav { list-style: none; padding: 0; margin-top: 40px; }

        .step-item {
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: 0.3s;
            cursor: pointer;
        }
        .step-item:hover { color: rgba(255,255,255,0.9); }
        .step-item.active { color: white; font-weight: 600; }

        .step-number {
            background: rgba(255,255,255,0.2);
            width: 24px; height: 24px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.8rem;
        }
        .step-item.active .step-number { background: var(--accent); color: var(--primary); }

        .sidebar-actions { margin-top: auto; padding-top: 20px; display: flex; flex-direction: column; gap: 10px; }

        .btn-sidebar {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: 0.2s;
        }
        .btn-sidebar:hover { background: rgba(255,255,255,0.2); }

        /* --- MAIN CONTENT --- */
        .main-content {
            flex-grow: 1;
            padding: 40px 60px;
            overflow-y: auto;
            background-color: #f8f9fa;
            height: 100vh;
        }
        
        .content-card {
            background: white;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            max-width: 1000px;
            margin: 0 auto;
            position: relative;
        }

        /* Badge Demo */
        .demo-badge {
            position: absolute;
            top: -15px; right: 20px;
            background: var(--warning);
            color: #333;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title { font-size: 1.8rem; margin-bottom: 10px; color: var(--primary); }
        .section-subtitle { color: var(--text-sec); font-size: 1rem; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; }

        .btn-magic-fill {
            background: #e3f2fd; color: #1565c0; border: none; padding: 5px 15px;
            border-radius: 6px; cursor: pointer; font-size: 0.8rem; font-weight: 600;
            display: flex; align-items: center; gap: 5px; transition: 0.2s;
        }
        .btn-magic-fill:hover { background: #bbdefb; }

        /* --- FORM ELEMENTS --- */
        .input-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; }
        .form-group { margin-bottom: 20px; position: relative; }
        
        label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 10px; color: var(--text-main); }

        .info-icon {
            display: inline-block; width: 18px; height: 18px; background: #eee; color: #666;
            border-radius: 50%; text-align: center; line-height: 18px; font-size: 12px; cursor: help; margin-left: 5px;
        }
        .info-icon:hover::after {
            content: attr(data-tooltip); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%);
            background: #333; color: white; padding: 8px; border-radius: 4px; font-size: 12px; width: 220px; z-index: 10; pointer-events: none;
        }

        input[type="number"], select {
            width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 8px;
            font-family: inherit; font-size: 1rem; transition: 0.3s; background: #fafafa;
        }
        input:focus { outline: none; border-color: var(--primary); background: white; box-shadow: 0 0 0 3px rgba(106, 27, 154, 0.1); }

        .symptom-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
        .symptom-card { position: relative; }
        .symptom-card input { position: absolute; opacity: 0; cursor: pointer; height: 0; width: 0; }

        .checkmark {
            display: flex; align-items: center; padding: 20px; background: white;
            border: 1px solid #e0e0e0; border-radius: 12px; cursor: pointer; transition: 0.2s;
            font-size: 0.95rem; height: 100%; box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }
        .checkmark:hover { background: #fcfcfc; border-color: #bbb; transform: translateY(-2px); }
        .symptom-card input:checked ~ .checkmark { background: #f3e5f5; border-color: var(--primary); color: var(--primary); font-weight: 700; box-shadow: inset 0 0 0 1px var(--primary); }

        /* --- BUTTONS --- */
        .actions { margin-top: 50px; display: flex; justify-content: flex-end; gap: 20px; padding-top: 20px; border-top: 1px solid #eee; }

        .btn {
            padding: 14px 35px; border: none; border-radius: 10px; cursor: pointer;
            font-weight: 600; font-size: 1rem; transition: 0.3s; display: inline-flex;
            align-items: center; justify-content: center; gap: 10px;
        }
        .btn-primary { background: var(--primary); color: white; box-shadow: 0 4px 15px rgba(106, 27, 154, 0.3); }
        .btn-primary:hover { background: var(--primary-light); transform: translateY(-2px); }
        .btn-ghost { background: transparent; color: var(--text-sec); border: 1px solid transparent; }
        .btn-ghost:hover { background: #f0f0f0; border-color: #ddd; }

        .btn-ai {
            background: var(--ai-gradient); color: white; box-shadow: 0 4px 15px rgba(255, 64, 129, 0.3);
            border: 1px solid rgba(255,255,255,0.2); padding: 16px 40px; font-size: 1.05rem;
        }
        .btn-ai:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 25px rgba(255, 64, 129, 0.5); }

        /* --- RESULTS --- */
        #resultsView { display: none; animation: fadeIn 0.5s; }
        .result-header { text-align: center; margin-bottom: 40px; }
        
        .gauge-wrapper { position: relative; width: 260px; height: 130px; margin: 0 auto 30px; overflow: hidden; }
        .gauge-bg { width: 260px; height: 260px; border-radius: 50%; background: #eee; position: absolute; top: 0; }
        .gauge-fill {
            width: 260px; height: 260px; border-radius: 50%;
            background: conic-gradient(var(--success) 0% 33%, var(--warning) 33% 66%, var(--danger) 66% 100%);
            position: absolute; top: 0; transform: rotate(-90deg); transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
            mask: radial-gradient(transparent 60%, black 61%); -webkit-mask: radial-gradient(transparent 60%, black 61%);
        }
        .gauge-needle {
            width: 6px; height: 110px; background: #333; position: absolute; bottom: 0; left: 50%;
            transform-origin: bottom center; transform: rotate(-90deg); transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
            border-radius: 4px; z-index: 2;
        }
        .gauge-hub { width: 20px; height: 20px; background: #333; border-radius: 50%; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); z-index: 3; }

        .metrics-container { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }
        .metric-card { background: #f8f9fa; padding: 25px; border-radius: 12px; text-align: center; border: 1px solid #eee; }
        .metric-val { display: block; font-size: 1.8rem; font-weight: 700; color: var(--primary); }
        .metric-label { font-size: 0.9rem; color: var(--text-sec); margin-top: 5px;}

        .advice-box { background: #e8f5e9; padding: 25px; border-left: 5px solid var(--success); border-radius: 8px; margin-bottom: 30px; font-size: 1.05rem; line-height: 1.6; }
        .advice-box.high-risk { background: #ffebee; border-color: var(--danger); }
        .advice-box.med-risk { background: #fff8e1; border-color: var(--warning); }

        /* --- AI SECTION --- */
        .ai-section { margin-top: 40px; border-top: 1px solid #eee; padding-top: 30px; }
        .ai-result-box {
            background: linear-gradient(to bottom right, #fff, #fcf4fc); border: 1px solid #f8bbd0;
            border-radius: 16px; padding: 30px; margin-top: 30px; font-size: 1rem; line-height: 1.7;
            color: #4a148c; display: none; position: relative; box-shadow: 0 10px 30px rgba(233, 30, 99, 0.05);
        }
        .ai-result-box h3 { margin-top: 0; color: #880e4f; font-size: 1.3rem; display: flex; align-items: center; gap: 10px; }
        .loading-spinner {
            display: none; width: 24px; height: 24px; border: 3px solid rgba(255,255,255,0.3);
            border-radius: 50%; border-top-color: white; animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* --- MEDIA QUERIES --- */
        @media print {
            body { background: white; display: block; height: auto; overflow: visible; }
            .app-container { display: block; height: auto; }
            .sidebar, .actions, .info-icon, .step-nav, .btn-ai, .sidebar-actions, #presentationOverlay, .demo-badge, .btn-magic-fill { display: none !important; }
            .content-card { box-shadow: none; padding: 0; max-width: none; }
            #inputSection { display: none; }
            #resultsView { display: block !important; }
            .gauge-wrapper { display: none; }
            .ai-result-box { display: block !important; background: white; border: 1px solid #ccc; }
            .print-score { display: block !important; font-size: 2rem; font-weight: bold; color: var(--primary); margin: 20px 0; padding: 10px; border: 1px solid #ddd; text-align: center; }
            .header-print, .footer-print { display: block !important; }
        }
        .header-print, .footer-print, .print-score { display: none; }
        .header-print { border-bottom: 2px solid var(--primary); padding-bottom: 20px; margin-bottom: 30px; }
        .footer-print { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 0.8rem; color: #999; border-top: 1px solid #ddd; padding-top: 10px; }

        @media (max-width: 900px) {
            .app-container { flex-direction: column; height: auto; overflow-y: auto; }
            body { height: auto; overflow-y: auto; }
            .sidebar { width: 100%; height: auto; padding: 20px; flex-direction: row; align-items: center; flex-wrap: wrap; }
            .steps-nav { display: none; }
            .main-content { height: auto; padding: 20px; }
            .input-grid { grid-template-columns: 1fr 1fr; }
            .sidebar-actions { width: auto; margin: 0; padding: 0; margin-left: auto; flex-direction: row; }
            .btn-sidebar { width: auto; padding: 8px 15px; }
        }
        @media (max-width: 600px) {
            .input-grid { grid-template-columns: 1fr; }
            .actions { flex-direction: column-reverse; }
            .btn { width: 100%; }
            .sidebar { flex-direction: column; align-items: stretch; }
            .sidebar-actions { margin: 20px 0 0 0; width: 100%; flex-direction: column; }
            .content-card { padding: 20px; }
            .pres-title { font-size: 2rem; }
        }
    </style>
</head>
<body>

<!-- PANTALLA DE PRESENTACIÓN (SPLASH SCREEN) -->
<div id="presentationOverlay">
    <div class="pres-content">
        <h1 class="pres-title">SOP Analytics</h1>
        <p class="pres-subtitle">Escanea para probar la Demo en vivo</p>
        
        <div id="qrBigContainer">
            <div id="qrcodeBig"></div>
        </div>

        <br>
        <button class="btn-start-demo" onclick="hidePresentation()">
            🚀 Iniciar Dashboard
        </button>
        
        <p style="margin-top: 20px; font-size: 0.8rem; color: rgba(255,255,255,0.5);">
            Asegúrate de estar conectado a la red
        </p>
    </div>
</div>

<div class="app-container">
    <!-- Barra Lateral -->
    <aside class="sidebar">
        <div class="brand">
            <h2>SOP<span style="color:var(--accent)">Analytics</span></h2>
            <span>Herramienta de Tamizaje</span>
        </div>

        <ul class="steps-nav">
            <li class="step-item active" id="navStep1">
                <span class="step-number">1</span>
                <span>Datos Biométricos</span>
            </li>
            <li class="step-item" id="navStep2">
                <span class="step-number">2</span>
                <span>Sintomatología</span>
            </li>
            <li class="step-item" id="navStep3">
                <span class="step-number">3</span>
                <span>Resultados</span>
            </li>
        </ul>

        <div class="sidebar-actions">
            <button class="btn-sidebar" onclick="showPresentation()">
                📺 Modo Presentación
            </button>
        </div>

        <div style="font-size: 0.7rem; opacity: 0.5; margin-top: 15px;">
            &copy; 2025 Univ. Project<br>
            Powered by Gemini AI ✨
        </div>
    </aside>

    <!-- Contenido Principal -->
    <main class="main-content">
        <div class="content-card">
            <div class="demo-badge">Demo Version 1.0</div>

            <!-- Header Print -->
            <div class="header-print">
                <h1>Informe de Evaluación de Riesgo</h1>
                <p>Generado por SOP Analytics - Herramienta de Apoyo al Diagnóstico</p>
                <p><strong>Fecha:</strong> <span id="printDate"></span></p>
            </div>

            <!-- FORMULARIO -->
            <div id="inputSection">
                <div style="margin-bottom: 40px;">
                    <h2 class="section-title">Datos del Paciente</h2>
                    <p class="section-subtitle">
                        Ingrese los datos fisiológicos.
                        <!-- BOTÓN MÁGICO DE DEMO -->
                        <button type="button" class="btn-magic-fill" onclick="populateDemoData()">
                            ⚡ Llenar Datos de Prueba
                        </button>
                    </p>

                    <form id="mainForm">
                        <div class="input-grid">
                            <div class="form-group">
                                <label>Edad (años)</label>
                                <input type="number" id="age" placeholder="20" min="12" max="60">
                            </div>
                            <div class="form-group">
                                <label>Peso (kg)</label>
                                <input type="number" id="weight" placeholder="65.5" step="0.1">
                            </div>
                            <div class="form-group">
                                <label>Altura (cm)</label>
                                <input type="number" id="height" placeholder="165">
                            </div>
                            <div class="form-group">
                                <label>Cintura (cm) <span class="info-icon" data-tooltip="Medida justo encima del ombligo. Importante para riesgo metabólico.">?</span></label>
                                <input type="number" id="waist" placeholder="80">
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="section-title">Cuadro Clínico</h2>
                        <p class="section-subtitle">Seleccione los signos y síntomas presentes.</p>
                        
                        <div class="symptom-grid">
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="30" data-name="Irregularidad Menstrual">
                                <span class="checkmark">Irregularidad Menstrual (Ciclos > 35 días)</span>
                            </label>
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="25" data-name="Hirsutismo (Exceso vello)">
                                <span class="checkmark">Hirsutismo (Vello facial/corporal excesivo)</span>
                            </label>
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="15" data-name="Acné Androgénico">
                                <span class="checkmark">Acné Androgénico (Mandíbula/Espalda)</span>
                            </label>
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="15" data-name="Alopecia Androgénica">
                                <span class="checkmark">Alopecia (Caída de cabello patrón central)</span>
                            </label>
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="10" data-name="Acantosis Nigricans">
                                <span class="checkmark">Acantosis Nigricans (Manchas oscuras en cuello)</span>
                            </label>
                            <label class="symptom-card">
                                <input type="checkbox" class="symptom" value="10" data-name="Antecedentes Familiares">
                                <span class="checkmark">Antecedentes Familiares de SOP/Diabetes</span>
                            </label>
                        </div>
                    </div>

                    <div class="actions">
                        <button type="button" class="btn btn-ghost" onclick="document.getElementById('mainForm').reset()">Limpiar</button>
                        <button type="submit" class="btn btn-primary">Analizar Riesgo &rarr;</button>
                    </div>
                    </form>
            </div>

            <!-- RESULTADOS -->
            <div id="resultsView">
                <div class="result-header">
                    <h2>Análisis Completado</h2>
                    <p>Basado en los datos proporcionados</p>
                </div>

                <div class="gauge-wrapper">
                    <div class="gauge-bg"></div>
                    <div class="gauge-fill"></div>
                    <div class="gauge-needle" id="needle"></div>
                    <div class="gauge-hub"></div>
                </div>
                
                <div class="print-score" id="printScoreText"></div>

                <div style="text-align: center; margin-bottom: 40px;">
                    <h1 style="font-size: 2.2rem; margin: 10px 0; font-weight: 800;" id="riskTitle">Calculando...</h1>
                    <p style="color: var(--text-sec); font-size: 1.1rem;" id="riskSubtitle">Probabilidad estimada</p>
                </div>

                <div class="metrics-container">
                    <div class="metric-card">
                        <span class="metric-val" id="displayIMC">-</span>
                        <span class="metric-label">IMC (kg/m²)</span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-val" id="displayICA">-</span>
                        <span class="metric-label">ICA (Cintura/Altura)</span>
                    </div>
                </div>

                <div class="advice-box" id="adviceBox"></div>

                <div class="ai-section">
                    <div style="display: flex; justify-content: center; margin-bottom: 20px;">
                         <button type="button" class="btn btn-ai" id="aiButton" onclick="generateAIPlan()">
                            <div class="loading-spinner" id="aiSpinner"></div>
                            <span id="aiBtnText">✨ Generar Plan de Bienestar Personalizado con IA</span>
                        </button>
                    </div>
                    <div id="aiResult" class="ai-result-box">
                        <h3><span style="font-size:1.5rem;">✨</span> Recomendaciones de tu Asistente IA</h3>
                        <div id="aiContent"></div>
                        <div style="font-size: 0.75rem; margin-top: 20px; color: #888; border-top: 1px dashed #ccc; padding-top: 10px;">
                            IA Generativa (Gemini) - No sustituye consejo médico.
                        </div>
                    </div>
                </div>

                <div class="actions" style="margin-top: 40px; border-top: 1px solid #eee; padding-top: 30px;">
                    <button type="button" class="btn btn-ghost" onclick="location.reload()">Nueva Evaluación</button>
                    <button type="button" class="btn btn-primary" onclick="window.print()">Descargar Informe PDF</button>
                </div>
                
                <div style="margin-top: 40px; font-size: 0.8rem; color: #999; text-align: center;">
                    Nota: Algoritmo basado en Criterios de Rotterdam.
                </div>
            </div>
        </div>
        <div class="footer-print">Generado con fines educativos.</div>
    </main>
</div>

<script>
    let patientData = {};
    const apiKey = ""; 
    let qrGenerated = false;

    // --- LOGICA DE PRESENTACIÓN & QR ---
    function showPresentation() {
        document.getElementById('presentationOverlay').classList.remove('hidden');
        generateQR();
    }

    function hidePresentation() {
        document.getElementById('presentationOverlay').classList.add('hidden');
    }

